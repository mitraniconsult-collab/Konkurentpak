# Set only in Vercel Environment Variables or local .env (never commit real secrets)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/konkurentpak?sslmode=require"
NEXT_PUBLIC_SITE_URL="https://your-preview-domain.vercel.app"
# Public Supabase project configuration. Never put a secret/service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
